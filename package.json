{
  "name": "arcade-ui",
  "version": "0.1.0",
  "description": "16-bit retro themed React component library",
  "license": "MIT",
  "author": "Arcade-UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcade-ui/arcade-ui.git"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "scaffold": "node scripts/ponytail-scaffold.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/manager-api": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/theming": "8.6.18",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.18",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  },
  "packageManager": "pnpm@12.8.1",
  "ponytail": {
    "type": "component-library",
    "css": "css-modules",
    "framework": "react",
    "skills": [
      ".mcp/dev-skill.json"
    ],
    "scaffold": "./scripts/ponytail-scaffold.mjs"
  }
}
